APP_NAME=ShareContest
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sharecontest.kuruk.in
APP_HOST=sharecontest.kuruk.in

LOG_CHANNEL=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres_postgres
DB_PORT=5432
DB_DATABASE=sharecontest
DB_USERNAME=sharecontest
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=redis_redis
REDIS_PORT=6379
REDIS_PREFIX=sharecontest_
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

CONTEST_HASHTAG=#MiConcurso2026
ADMIN_USER=admin
ADMIN_PASSWORD=

# Server-to-server JAKAWI integration. Never expose this token to browsers.
SHARECONTEST_API_TOKEN=
SHARECONTEST_API_RATE_LIMIT=60
